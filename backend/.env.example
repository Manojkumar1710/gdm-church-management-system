# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# --- Database ---
DB_URL=jdbc:mysql://localhost:3306/gdm_church?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=your-database-password

# --- JWT ---
# Must be at least 32 characters (256 bits)
JWT_SECRET=change-me-to-a-long-random-secret-value-min-32-chars
JWT_EXPIRATION_MS=86400000

# --- CORS ---
FRONTEND_URL=http://localhost:5173

# --- Admin seed account ---
ADMIN_SEED_EMAIL=admin@gdmchurch.org
ADMIN_SEED_PASSWORD=your-admin-password

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# --- Payment (Phase 13 only) ---
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=

# --- Server ---
PORT=8080